# =============================================================================
# Biso24 MCP server configuration
# Copy to `.env` (git-ignored) and fill in; mise loads it (mise.toml [env]).
# Never commit real credentials.
# =============================================================================

# --- Account (required) ------------------------------------------------------
# The server logs in with these and logs in again when the JWT (~24h) expires.
BISO24_EMAIL=
BISO24_PASSWORD=

# --- Tenant (required) -------------------------------------------------------
# Organization id (`orgId` in the web app's login request)
BISO24_ORG_ID=
# Tenant domain, sent as the `domain` header (e.g. acme.biso24.net)
BISO24_DOMAIN=acme.biso24.net

# --- Services (optional) -----------------------------------------------------
# Base URL of the IAM service (also hosts the login endpoint)
# Default: https://iam.biso24.org
BISO24_IAM_URL=https://iam.biso24.org

# --- Bruno (optional) --------------------------------------------------------
# Seed JWT for the Bruno collection; used until it expires, then it logs in again.
# The MCP server ignores it.
BISO24_TOKEN=

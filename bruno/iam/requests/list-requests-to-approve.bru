meta {
  name: List requests to approve
  type: http
  seq: 3
}

get {
  url: {{iamUrl}}/v1/request-employees?limit=20&page=1&type=RESPONSIBLE
  body: none
  auth: inherit
}

params:query {
  limit: 20
  page: 1
  type: RESPONSIBLE
  ~requestCategoryCode: LEAVE
}

assert {
  res.status: eq 200
}

docs {
  `type=RESPONSIBLE`. API reference: `docs/api/iam/requests.md`.
}

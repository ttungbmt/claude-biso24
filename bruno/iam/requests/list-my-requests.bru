meta {
  name: List my requests
  type: http
  seq: 2
}

get {
  url: {{iamUrl}}/v1/request-employees?limit=20&page=1&type=OWNER
  body: none
  auth: inherit
}

params:query {
  limit: 20
  page: 1
  type: OWNER
  ~status: PROCESSING
  ~requestCategoryCode: LEAVE
  ~requestCategoryId:
  ~fromRegistrationDate: 2026-09-01
  ~toRegistrationDate: 2026-09-30
  ~from: 2026-01-01
  ~to: 2026-12-31
  ~q:
  ~employeeId:
  ~departmentId:
  ~positionId:
}

assert {
  res.status: eq 200
}

docs {
  `type=OWNER`. Optional params are disabled; toggle them to try. API reference: `docs/api/iam/requests.md`.
}

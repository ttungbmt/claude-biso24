meta {
  name: Approve requests
  type: http
  seq: 9
  tags: [
    write
  ]
}

post {
  url: {{iamUrl}}/v1/request-employees/multiple-approvals
  body: json
  auth: inherit
}

body:json {
  [
    {
      "_id": "{{process.env.BISO24_REQUEST_ID}}",
      "approvalForNextStep": {
        "employeeId": "{{process.env.BISO24_NEXT_APPROVER_ID}}",
        "staffCode": "{{process.env.BISO24_NEXT_APPROVER_STAFF_CODE}}",
        "fullName": "{{process.env.BISO24_NEXT_APPROVER_NAME}}"
      }
    }
  ]
}

docs {
  Approves a Request awaiting my approval for real ("Duyệt"). Tagged `write`, so `pnpm api` skips
  it; run it on its own from `bruno/` with `BISO24_REQUEST_ID` and the next step's approver
  (`BISO24_NEXT_APPROVER_ID`, `_STAFF_CODE`, `_NAME`, from the Request's `approvalSteps`).
  API reference: `docs/api/iam/requests.md`.
}

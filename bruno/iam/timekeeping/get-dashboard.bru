meta {
  name: Get timekeeping dashboard
  type: http
  seq: 2
}

get {
  url: {{iamUrl}}/v1/timekeeping-employees/dashboard?year=2026
  body: none
  auth: inherit
}

params:query {
  year: 2026
}

assert {
  res.status: eq 200
}

docs {
  Yearly timekeeping summary of the logged-in employee (identified by the token).
  - `year`: 4 digits
}

meta {
  name: Get personal timekeeping data
  type: http
  seq: 1
}

get {
  url: {{iamUrl}}/v1/timekeeping-employees/personal-data?month=09&year=2026
  body: none
  auth: inherit
}

params:query {
  month: 09
  year: 2026
}

assert {
  res.status: eq 200
}

docs {
  API reference: `docs/api/iam/timekeeping.md`.
}

meta {
  name: Get employee
  type: http
  seq: 1
}

get {
  url: {{iamUrl}}/v1/employees/:id?histories=true&profiles=true
  body: none
  auth: inherit
}

params:query {
  histories: true
  profiles: true
}

params:path {
  id: {{employeeId}}
}

assert {
  res.status: eq 200
}

docs {
  Gets one employee by id (defaults to the logged-in employee).
  - `histories=true`: include the work history
  - `profiles=true`: include the profile records
}
